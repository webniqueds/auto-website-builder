# At least one AI provider key is required for generation.
# Priority order: NVIDIA NIM -> GROQ -> OpenRouter (each with its own budget).
# NIM is the primary provider; leave the others blank to skip them entirely.
#
# In practice generation does not fail when a key is missing or a provider
# rejects a call: the provider chain races and the first success wins. A
# provider only becomes fatal once every configured provider has failed.

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b

GROQ_API_KEY=
# Groq retires models frequently. Override if the default is unavailable;
# list what your key can reach with GET https://api.groq.com/openai/v1/models
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: override the OpenRouter model (defaults to a free model).
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=

# Optional: enables live Unsplash photo search instead of curated image sets.
UNSPLASH_ACCESS_KEY=

# --- Razorpay (Pro plan payments) ---
# Get keys from https://dashboard.razorpay.com (test mode uses rzp_test_ keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currency and one-time Pro price (in base currency units, e.g., rupees for INR).
RAZORPAY_CURRENCY=INR
RAZORPAY_PRO_PRICE=499
# Set RAZORPAY_DEMO=1 to simulate payments end-to-end without needing to
# configure live keys (checkout is faked and always "succeeds").
# RAZORPAY_DEMO=1

# --- MongoDB (optional durable storage) ---
# Projects and purchases sync to MongoDB when this is set. Without it the
# server falls back to an in-memory store (still works locally/fire-and-forget).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=website-builder

# --- Clerk (authentication) ---
# Get keys from https://dashboard.clerk.com -> API keys.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Admin dashboard ---
# Comma-separated emails allowed into /admin (dashboards + plan management).
# SUPERADMIN_EMAILS=you@example.com,friend@example.com

# Local API port (not used on Vercel).
PORT=3001